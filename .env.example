# Copy to .env; Next.js loads it on start. The agent URL and headers
# are set in the page; AGENT_URL is only the default.

# AG-UI endpoint used when the page leaves the agent URL empty.
AGENT_URL=http://localhost:8000/chat

# docker compose only: the default as seen from the container, where
# localhost is the container itself.
# DOCKER_AGENT_URL=http://host.docker.internal:8000/chat

# Keep usage data local.
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
