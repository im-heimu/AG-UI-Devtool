# Copy to .env; Next.js loads it on start.

# AG-UI endpoint of the agent under test.
AGENT_URL=http://localhost:8000/chat

# Extra headers sent with every run, as a JSON object. A local gan
# with AUTH__TRUST_IDENTITY_HEADERS=true identifies the user by these:
AGENT_HEADERS='{"X-CURRENT-USER-ID": "11111111-1111-4111-8111-111111111111"}'

# Bearer token for agents that verify one; sent as Authorization.
# AGENT_TOKEN=

# docker compose only: the agent as seen from the container, where
# localhost is the container itself.
# DOCKER_AGENT_URL=http://host.docker.internal:8000/chat

# Keep usage data local.
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
